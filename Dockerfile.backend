# 万能短剧 AI 创作平台 · 后端镜像
# 运行：uvicorn server/main.py（:7788）。ComfyUI(:8188) / Ollama(:11434) 为外部可选服务。
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    MANJU_DB_PATH=/data/app.db \
    MANJU_LOG_DIR=/data/logs \
    MANJU_FRONTEND_DIR=/app/frontend/dist

WORKDIR /app

# 依赖分层缓存
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# 后端代码（含 workflow_templates / resource_catalog.json / intent_translator）
COPY server/ ./server/

# 运行用户（非 root）
RUN useradd -m -u 1000 manju && mkdir -p /data /app/outputs \
    && chown -R manju:manju /data /app/outputs
USER manju

EXPOSE 7788
VOLUME ["/data", "/app/outputs"]

CMD ["python", "server/main.py"]
