{
  "template_id": "character_genesis",
  "description": "角色参考图生成（SD1.5 + IPAdapterFaceID 人脸锁 + 可选 ControlNet），鸡生蛋环节：以结构化角色属性确定性锚定资产，绝不手搓节点。",
  "required_node_families": ["checkpoint_loader", "ip_adapter", "ksampler", "save_image"],
  "optional_node_families": ["controlnet_openpose", "controlnet_depth", "upscaler"],
  "semantic_nodes": {
    "checkpoint_loader": {
      "class_type": "CheckpointLoaderSimple",
      "inputs": { "ckpt_name": "{{checkpoint}}" }
    },
    "prompt_positive": {
      "class_type": "CLIPTextEncode",
      "inputs": { "text": "{{positive_prompt}}", "clip": ["checkpoint_loader", 1] }
    },
    "prompt_negative": {
      "class_type": "CLIPTextEncode",
      "inputs": { "text": "{{negative_prompt}}", "clip": ["checkpoint_loader", 1] }
    },
    "ip_adapter": {
      "class_type": "IPAdapterFaceID",
      "inputs": {
        "ipadapter": "{{ip_adapter_model}}",
        "clip_vision": "{{clip_vision_model}}",
        "insightface": "{{insightface}}",
        "model": ["checkpoint_loader", 0],
        "weight": "{{ip_adapter_weight}}",
        "face_embeds": "{{face_vector_base64}}"
      }
    },
    "ksampler": {
      "class_type": "KSampler",
      "inputs": {
        "model": ["ip_adapter", 0],
        "positive": ["prompt_positive", 0],
        "negative": ["prompt_negative", 0],
        "latent_image": ["empty_latent", 0],
        "seed": "{{seed}}",
        "steps": "{{steps}}",
        "cfg": "{{cfg_scale}}",
        "sampler_name": "{{sampler}}",
        "scheduler": "{{scheduler}}"
      }
    },
    "empty_latent": {
      "class_type": "EmptyLatentImage",
      "inputs": { "width": "{{width}}", "height": "{{height}}", "batch_size": 1 }
    },
    "vae_decode": {
      "class_type": "VAEDecode",
      "inputs": { "samples": ["ksampler", 0], "vae": ["checkpoint_loader", 2] }
    },
    "save_image": {
      "class_type": "SaveImage",
      "inputs": { "images": ["vae_decode", 0] }
    }
  },
  "placeholder_schema": {
    "{{checkpoint}}":         { "type": "string", "source": "catalog.match", "required": true },
    "{{positive_prompt}}":    { "type": "string", "source": "prompt_builder.build", "required": true },
    "{{negative_prompt}}":    { "type": "string", "source": "literal", "default": "low quality, blurry, watermark, deformed face, extra limbs, multiple panels, text" },
    "{{ip_adapter_model}}":   { "type": "string", "source": "catalog.match", "required": true },
    "{{clip_vision_model}}":  { "type": "string", "source": "catalog.match", "required": true },
    "{{insightface}}":        { "type": "string", "source": "literal", "default": "buffalo_l" },
    "{{face_vector_base64}}": { "type": "base64", "source": "asset.face_vector", "required": true },
    "{{ip_adapter_weight}}":  { "type": "float",  "default": 0.85, "range": [0.5, 1.0] },
    "{{seed}}":               { "type": "int",    "source": "style_anchor.derive_seed", "required": true },
    "{{steps}}":              { "type": "int",    "default": 30, "range": [10, 50] },
    "{{cfg_scale}}":          { "type": "float",  "default": 7.0, "range": [1.0, 15.0] },
    "{{width}}":              { "type": "int",    "default": 512 },
    "{{height}}":             { "type": "int",    "default": 768 },
    "{{sampler}}":            { "type": "string", "default": "euler" },
    "{{scheduler}}":          { "type": "string", "default": "normal" }
  }
}
