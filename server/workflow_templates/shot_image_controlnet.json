{
  "_doc": "带 ControlNet 的文生图模板（手册 P3 场景参考图约束构图）。拓扑与已验证手搓实现一致；{{ref_image}} 为已上传至 ComfyUI 的内部文件名，{{preprocess_node}} 为深度/姿态/线稿预处理节点类名。",
  "prompt": {
    "3": {"class_type": "KSampler", "inputs": {
      "seed": "{{seed}}", "steps": "{{steps}}", "cfg": "{{cfg}}",
      "sampler_name": "euler", "scheduler": "normal", "denoise": 1.0,
      "model": ["4", 0], "positive": ["14", 0], "negative": ["7", 0], "latent_image": ["5", 0]}},
    "4": {"class_type": "CheckpointLoaderSimple", "inputs": {"ckpt_name": "{{checkpoint}}"}},
    "5": {"class_type": "EmptyLatentImage", "inputs": {"width": "{{width}}", "height": "{{height}}", "batch_size": 1}},
    "6": {"class_type": "CLIPTextEncode", "inputs": {"text": "{{positive_prompt}}", "clip": ["4", 1]}},
    "7": {"class_type": "CLIPTextEncode", "inputs": {"text": "{{negative_prompt}}", "clip": ["4", 1]}},
    "8": {"class_type": "VAEDecode", "inputs": {"samples": ["3", 0], "vae": ["4", 2]}},
    "9": {"class_type": "SaveImage", "inputs": {"images": ["8", 0], "filename_prefix": "manju_seg_cn"}},
    "10": {"class_type": "LoadImage", "inputs": {"image": "{{ref_image}}"}},
    "11": {"class_type": "{{preprocess_node}}", "inputs": {"image": ["10", 0]}},
    "12": {"class_type": "ControlNetLoader", "inputs": {"control_net_name": "{{control_net_name}}"}},
    "13": {"class_type": "ControlNetApply", "inputs": {
      "conditioning": ["6", 0], "control_net": ["12", 0], "image": ["11", 0], "strength": "{{control_weight}}"}},
    "14": {"class_type": "ControlNetApply", "inputs": {
      "conditioning": ["13", 0], "control_net": ["12", 0], "image": ["11", 0], "strength": "{{control_weight}}"}}
  }
}
