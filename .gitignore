# ===== 依赖 =====
node_modules/

# ===== Python 缓存（但保留 server/_vendor 恢复用 .pyc） =====
__pycache__/
*.py[cod]
!server/_vendor/
!server/_vendor/*.pyc

# ===== 数据库 / 用户数据（绝不入库，避免把用户数据/密钥提交） =====
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
.uploads/
_archives/
_archives_legacy_projects_json/
_archive_legacy_projects_json/

# ===== 运行时日志 =====
logs/
*.log
__web_*.log

# ===== 环境变量 / 密钥 =====
.env
.env.*
.venv/
venv/
envs/

# ===== 构建产物（线上服务目录在 C: 的 MANJU_FRONTEND_DIR） =====
dist/
build/
frontend/dist/

# ===== 调试 / 临时产物（根级下划线文件） =====
_shots/
_shots_v3/
_check_*.png
_shot_*.png
_ui_final.png
*.accident
*.bak
.backups/

# ===== 生成物 / 自动备份 / 构建残留（可重新生成，不入库） =====
outputs/
versions/
gen_test.out
*.out
*.png
*.jpg
*.jpeg
*.gif
vite.config.js.timestamp-*.mjs
*.timestamp-*.mjs
__pycache__/*.txt
__pycache__/dis_*.txt
__pycache__/route_map.txt
__pycache__/pyc_strings.txt

# ===== 系统 =====
Thumbs.db
.DS_Store
