#!/usr/bin/env bash
# pre-commit —— 200KB 代码文件上限 + 数据库文件拦截（两道门合并于此）。
#
# 启用方式（必做，否则 Git 只会去找 .git/hooks/）：
#   git config core.hooksPath .githooks
# 仓库里放了 .git/hooks/pre-commit 转发脚本做双保险，即使 config 被清也拦得住。
#
# 被 --no-verify 绕过时，pre-push 会用同一份 lib/gate.sh 再判一次。
set -euo pipefail

GATE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/gate.sh
source "${GATE_DIR}/lib/gate.sh"

fail=0
# 只看「本次暂存」的文件：历史遗留的大文件不因为存在就被拦，
# 但一旦有人改动并暂存它们，就必须先拆分。
while IFS= read -r f; do
    [ -z "$f" ] && continue
    size=$(gate_blob_size ":${f}")
    if ! gate_verdict "$f" "$size" "HEAD"; then
        fail=1
    fi
done < <(git diff --cached --name-only --diff-filter=ACM)

if [ "$fail" -ne 0 ]; then
    gate_fail_message
    exit 1
fi
exit 0
