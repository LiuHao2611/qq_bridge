# ===== 本地运行数据 / 第三方子仓库（含独立 .git，禁止入库） =====
.research/
tmp/
vendor/
# Windows 保留设备名文件（命令行 > NUL 误生成的垃圾，git 无法索引）
NUL

# ===== 调试 scratch（根目录 _ 前缀 + 抓取 dump，按本仓库约定不入仓） =====
# 用 /_ 锚定 qq_bridge 根目录，避免误伤 src/ 内的 __init__.py
/_*
/.tmp_qqlogin/
/probe.py
/wf_wiki_*.html
# 任意层级的带时间戳备份目录（如 src/plugins/qq_bridge/_backup_riven_recommend_*）
_backup_*/

# ===== 隐私 / 二进制运行时（绝不入库） =====
*.exe
*.qqxlog

# ===== Warframe 市价卡货币图标：必需的**源码资产**，随代码交付 =====
# 主项目根 .gitignore 有全局 `*.png`（针对生成物/截图），这里按子目录规则精确放行
# 这三张是 DE 官方游戏内图标 / 按官方造型重绘的等价物，不是调试截图，也不进 data/。
!src/plugins/qq_bridge/pic/templates/assets/wf_currency/*.png

# ===== 签到卡黄金图标：必需的**源码资产**，随代码交付 =====
# 同样被根 `*.png` 命中，按子目录精确放行。7 枚 128x128 RGBA PNG：6 枚 FA Solid SVG
# 离线镀金（CC BY 4.0）+ 1 枚 coins.png 是本项目 AI 生成的电影级写实单枚金币
# （自制资产，build 不覆盖，见同目录 README.md），不是调试截图；缺图 gate(strict) 会硬拦。
!src/plugins/qq_bridge/pic/templates/assets/checkin_gold/*.png

# ===== 紫卡全面分析卡：仅「当前紫卡」母卡随代码交付 =====
# 用户 2026-11-12 明确「其他 mod 都是实时获取或者从缓存拿，禁止硬编码」：
#   * 前 N 张配卡 MOD 卡图一律运行期由 tools/gen_mod_cards.py::render_mod_card_wide
#     用真 DE 立绘 + 稀有度卡框**实时合成 + 内存缓存**（riven_full.py::_live_mod_image），
#     不落盘、不作为静态资产交付、不硬编码卡图映射；zh→en 由 mod_full.json 事实源反查。
#   * 唯一固定资产 = 第 8 格「当前紫卡」母版 mod_1_3.png（紫色星标）：紫卡是当前这张、
#     不随武器类型变、无法由 MOD 数据表合成，故精确放行这一张。
#   * 其余 7 张参考样例母版 mod_0_0..mod_1_2 只服务 reference_sample() 版式夹具，
#     不进交付（继续被根 `*.png` 忽略），容器 COPY src 带上仅供本地/容器视觉守门。
!src/plugins/qq_bridge/pic/templates/riven_full_assets/mod_1_3.png
